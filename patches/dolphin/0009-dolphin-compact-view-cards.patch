From 802a71c9218d6bc014cc730b0d64790ebf1e4e68 Mon Sep 17 00:00:00 2001
From: Afsarsyusuf <afsarsamiyusuf@gmail.com>
Date: Thu, 8 Oct 2026 18:42:52 +0300
Subject: [PATCH] Ro-ASD: card style for the compact view

---
 src/kitemviews/kstandarditemlistwidget.cpp | 4 ++--
 src/views/dolphinitemlistview.cpp          | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/kitemviews/kstandarditemlistwidget.cpp b/src/kitemviews/kstandarditemlistwidget.cpp
index eeb6f0b26..91789bc10 100644
--- a/src/kitemviews/kstandarditemlistwidget.cpp
+++ b/src/kitemviews/kstandarditemlistwidget.cpp
@@ -345,8 +345,8 @@ void KStandardItemListWidget::paint(QPainter *painter, const QStyleOptionGraphic
 {
     const_cast<KStandardItemListWidget *>(this)->triggerCacheRefreshing();
 
-    if (m_layout == IconsLayout) {
-        // Ro-ASD: every item in the icon view sits on a rounded card, as the folder cards in the design.
+    if (m_layout == IconsLayout || m_layout == CompactLayout) {
+        // Ro-ASD: every item in the icon and compact views sits on a rounded card, as the folder cards in the design.
         // Card color = base mixed with 7 % text (design: #252525 -> #323232), so it follows any color scheme.
         const QColor base = styleOption().palette.color(QPalette::Base);
         const QColor text = styleOption().palette.color(QPalette::Text);
diff --git a/src/views/dolphinitemlistview.cpp b/src/views/dolphinitemlistview.cpp
index dd5d8c62c..b7da5cbab 100644
--- a/src/views/dolphinitemlistview.cpp
+++ b/src/views/dolphinitemlistview.cpp
@@ -197,7 +197,7 @@ void DolphinItemListView::updateGridSize()
     KItemListStyleOption option = styleOption();
 
     // Ro-ASD: more inner space in the icon view so items read as cards (upstream: 2 for all layouts).
-    const int padding = (itemLayout() == KFileItemListView::IconsLayout) ? 8 : 2;
+    const int padding = (itemLayout() == KFileItemListView::IconsLayout) ? 8 : (itemLayout() == KFileItemListView::CompactLayout) ? 6 : 2;
     int horizontalMargin = 0;
     int verticalMargin = 0;
 
-- 
2.55.0

