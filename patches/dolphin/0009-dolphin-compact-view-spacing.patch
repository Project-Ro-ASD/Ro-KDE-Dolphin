From 65497e4e728b56ed251e133239a2d299f66acf9b Mon Sep 17 00:00:00 2001
From: Afsarsyusuf <afsarsamiyusuf@gmail.com>
Date: Wed, 21 Oct 2026 14:48:59 +0300
Subject: [PATCH] Ro-ASD: more spacing in the compact view

---
 src/views/dolphinitemlistview.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/views/dolphinitemlistview.cpp b/src/views/dolphinitemlistview.cpp
index b13f5ee..8b7239c 100644
--- a/src/views/dolphinitemlistview.cpp
+++ b/src/views/dolphinitemlistview.cpp
@@ -196,8 +196,8 @@ void DolphinItemListView::updateGridSize()
     m_zoomLevel = ZoomLevelInfo::zoomLevelForIconSize(QSize(iconSize, iconSize));
     KItemListStyleOption option = styleOption();
 
-    // Ro-ASD: more space around items in the icon view (upstream: 2 for all layouts).
-    const int padding = (itemLayout() == KFileItemListView::IconsLayout) ? 8 : 2;
+    // Ro-ASD: more space around items in the icon and compact views (upstream: 2 for all layouts).
+    const int padding = (itemLayout() == KFileItemListView::IconsLayout) ? 8 : (itemLayout() == KFileItemListView::CompactLayout) ? 6 : 2;
     int horizontalMargin = 0;
     int verticalMargin = 0;
 
-- 
