From 0451832cc1af44a45f3a7cb1ba461508578270db Mon Sep 17 00:00:00 2001
From: Afsarsyusuf <afsarsamiyusuf@gmail.com>
Date: Thu, 8 Oct 2026 16:25:10 +0300
Subject: [PATCH] Ro-ASD: card style for the icon view

---
 src/kitemviews/kstandarditemlistwidget.cpp  | 19 +++++++++++++++++++
 src/settings/dolphin_iconsmodesettings.kcfg |  3 ++-
 src/views/dolphinitemlistview.cpp           |  3 ++-
 3 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/kitemviews/kstandarditemlistwidget.cpp b/src/kitemviews/kstandarditemlistwidget.cpp
index 1c607ba0d..ceaca396f 100644
--- a/src/kitemviews/kstandarditemlistwidget.cpp
+++ b/src/kitemviews/kstandarditemlistwidget.cpp
@@ -344,6 +344,25 @@ void KStandardItemListWidget::paint(QPainter *painter, const QStyleOptionGraphic
 {
     const_cast<KStandardItemListWidget *>(this)->triggerCacheRefreshing();
 
+    if (m_layout == IconsLayout) {
+        // Ro-ASD: every item in the icon view sits on a rounded card, as the folder cards in the design.
+        // Card color = base mixed with 7 % text (design: #252525 -> #323232), so it follows any color scheme.
+        const QColor base = styleOption().palette.color(QPalette::Base);
+        const QColor text = styleOption().palette.color(QPalette::Text);
+        const qreal mix = 0.07;
+        const QColor card = QColor::fromRgbF(base.redF() + (text.redF() - base.redF()) * mix,
+                                             base.greenF() + (text.greenF() - base.greenF()) * mix,
+                                             base.blueF() + (text.blueF() - base.blueF()) * mix);
+        const QRectF cardRect = QRectF(QPointF(0, 0), size()).adjusted(2, 2, -2, -2);
+        const qreal radius = qMin(12.0, cardRect.width() / 8.0);
+        painter->save();
+        painter->setRenderHint(QPainter::Antialiasing);
+        painter->setPen(Qt::NoPen);
+        painter->setBrush(card);
+        painter->drawRoundedRect(cardRect, radius, radius);
+        painter->restore();
+    }
+
     KItemListWidget::paint(painter, option, widget);
 
     if (!m_expansionArea.isEmpty()) {
diff --git a/src/settings/dolphin_iconsmodesettings.kcfg b/src/settings/dolphin_iconsmodesettings.kcfg
index 7948af75d..eabc1eb02 100644
--- a/src/settings/dolphin_iconsmodesettings.kcfg
+++ b/src/settings/dolphin_iconsmodesettings.kcfg
@@ -17,7 +17,8 @@
         </entry>
         <entry name="IconSize" type="Int">
             <label>Icon size</label>
-            <default code="true">KIconLoader::SizeMedium</default>
+            <!-- Ro-ASD default: 48 for the card layout (upstream: KIconLoader::SizeMedium) -->
+            <default code="true">KIconLoader::SizeLarge</default>
         </entry>
         <entry name="PreviewSize" type="Int">
             <label>Preview size</label>
diff --git a/src/views/dolphinitemlistview.cpp b/src/views/dolphinitemlistview.cpp
index af33157f4..dd5d8c62c 100644
--- a/src/views/dolphinitemlistview.cpp
+++ b/src/views/dolphinitemlistview.cpp
@@ -196,7 +196,8 @@ void DolphinItemListView::updateGridSize()
     m_zoomLevel = ZoomLevelInfo::zoomLevelForIconSize(QSize(iconSize, iconSize));
     KItemListStyleOption option = styleOption();
 
-    const int padding = 2;
+    // Ro-ASD: more inner space in the icon view so items read as cards (upstream: 2 for all layouts).
+    const int padding = (itemLayout() == KFileItemListView::IconsLayout) ? 8 : 2;
     int horizontalMargin = 0;
     int verticalMargin = 0;
 
-- 
