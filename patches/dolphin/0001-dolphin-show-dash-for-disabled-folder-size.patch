From: Afsarsyusuf <afsarsamiyusuf@gmail.com>
Date: Thu, 1 Oct 2026 18:35:50 +0300
Subject: [PATCH] Ro-ASD: show a dash for folder size when sizes are disabled

---
 src/kitemviews/kfileitemlistwidget.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/kitemviews/kfileitemlistwidget.cpp b/src/kitemviews/kfileitemlistwidget.cpp
index ccb1819af..6c7c9d57e 100644
--- a/src/kitemviews/kfileitemlistwidget.cpp
+++ b/src/kitemviews/kfileitemlistwidget.cpp
@@ -65,7 +65,10 @@ QString KFileItemListWidgetInformant::roleText(const QByteArray &role, const QHa
 
     if (role == "size") {
         if (values.value("isDir").toBool()) {
-            if (!roleValue.isNull() && roleValue != -1) {
+            if (ContentDisplaySettings::directorySizeMode() == ContentDisplaySettings::EnumDirectorySizeMode::None) {
+                // Ro-ASD: show a dash instead of an empty cell when folder sizes are disabled.
+                text = QStringLiteral("\u2014");
+            } else if (!roleValue.isNull() && roleValue != -1) {
                 // The item represents a directory.
                 if (ContentDisplaySettings::directorySizeMode() == ContentDisplaySettings::EnumDirectorySizeMode::ContentCount
                     || roleValue == -2 /* size is invalid */) {
