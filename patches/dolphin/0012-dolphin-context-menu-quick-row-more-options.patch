+// Ro-ASD: large buttons in a row at the top of the context menu (design "B"). Each button
+// mirrors an existing Dolphin action (icon, enabled and checked state, shortcut in the
+// tooltip) and triggers it; nothing new is added to what the actions do.
+class RoQuickButton : public QToolButton
+{
+public:
+    using QToolButton::QToolButton;
+
+protected:
+    void paintEvent(QPaintEvent *event) override
+    {
+        {
+            // Tile = window color mixed with 7 % text, so it follows any color scheme.
+            QPainter painter(this);
+            painter.setRenderHint(QPainter::Antialiasing);
+            painter.setPen(Qt::NoPen);
+            const QColor bg = palette().window().color();
+            const QColor fg = palette().windowText().color();
+            const qreal mix = 0.07;
+            painter.setBrush(QColor::fromRgbF(bg.redF() + (fg.redF() - bg.redF()) * mix,
+                                              bg.greenF() + (fg.greenF() - bg.greenF()) * mix,
+                                              bg.blueF() + (fg.blueF() - bg.blueF()) * mix));
+            painter.drawRoundedRect(QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5), 6, 6);
+        }
+        QToolButton::paintEvent(event);
+    }
+};
+
+struct RoQuickEntry {
+    QAction *action;
+    std::function<QString()> label;
+    // Optional icon for the button; falls back to the action's icon when the theme lacks it.
+    QString iconName = {};
+};
+
+void roAddQuickRow(QMenu *menu, const QList<RoQuickEntry> &entries)
+{
+    auto *row = new QWidget(menu);
+    auto *layout = new QHBoxLayout(row);
+    layout->setContentsMargins(4, 2, 4, 4);
+    layout->setSpacing(4);
+    int count = 0;
+    for (const RoQuickEntry &entry : entries) {
+        QAction *action = entry.action;
+        if (!action) {
+            continue;
+        }
+        auto *button = new RoQuickButton(row);
+        button->setToolButtonStyle(Qt::ToolButtonTextUnderIcon);
+        button->setAutoRaise(true);
+        button->setIconSize(QSize(22, 22));
+        button->setMinimumSize(72, 58);
+        button->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+        button->setFocusPolicy(Qt::NoFocus);
+        const auto label = entry.label;
+        const QString iconName = entry.iconName;
+        const auto sync = [button, action, label, iconName]() {
+            button->setIcon(iconName.isEmpty() ? action->icon() : QIcon::fromTheme(iconName, action->icon()));
+            button->setText(label());
+            button->setEnabled(action->isEnabled());
+            button->setCheckable(action->isCheckable());
+            button->setChecked(action->isChecked());
+            QString tip = KLocalizedString::removeAcceleratorMarker(action->text());
+            if (!action->shortcut().isEmpty()) {
+                tip += QStringLiteral(" (%1)").arg(action->shortcut().toString(QKeySequence::NativeText));
+            }
+            button->setToolTip(tip);
+        };
+        sync();
+        QObject::connect(action, &QAction::changed, button, sync);
+        QObject::connect(button, &QToolButton::clicked, menu, [menu, action]() {
+            menu->close();
+            action->trigger();
+        });
+        layout->addWidget(button);
+        ++count;
+    }
+    if (count == 0) {
+        delete row;
+        return;
+    }
+    auto *rowAction = new QWidgetAction(menu);
+    rowAction->setDefaultWidget(row);
+    menu->addAction(rowAction);
+    menu->addSeparator();
+}
+
+QString roLabel(const char *text)
+{
+    return i18nd("ro-kde-dolphin", text);
+}
+
+// Ro-ASD: "More Options" submenu for open-with, plugins (actions, activities, tags, compress,
+// open as administrator) and version control. Only added when something landed in it.
+void roAddMoreMenu(QMenu *menu, QMenu *more)
+{
+    const QList<QAction *> actions = more->actions();
+    const bool hasEntries = std::any_of(actions.cbegin(), actions.cend(), [](const QAction *action) {
+        return !action->isSeparator() && action->isVisible();
+    });
+    menu->addSeparator();
+    if (hasEntries) {
+        // Submenu labels (KIO's Actions, Activities, ...) otherwise run into their arrow
+        more->setMinimumWidth(more->sizeHint().width() + 2 * more->fontMetrics().height());
+        menu->addMenu(more);
+    } else {
+        delete more;
+    }
+}
+
+QMenu *roCreateMoreMenu(QMenu *parent)
+{
+    auto *more = new QMenu(i18nd("ro-kde-dolphin", "More Options"), parent);
+    more->setIcon(QIcon::fromTheme(QStringLiteral("view-more-symbolic")));
+    return more;
+}
+}
 
